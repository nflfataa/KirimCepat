# =============================================================================
# KirimCepat - template environment untuk Docker Compose
# Cara pakai:  cp .env.example .env   lalu isi nilainya.
# File .env TIDAK BOLEH di-commit (sudah ada di .gitignore).
# Catatan: jangan pakai karakter "$" di password (Compose akan menganggapnya variabel).
# =============================================================================

# --- Docker Hub (nama image: <DOCKERHUB_USER>/kirimcepat:<IMAGE_TAG>) ---
# Username Docker Hub harus huruf kecil semua.
DOCKERHUB_USER=isi_username_dockerhub
IMAGE_TAG=latest

# --- Aplikasi ---
APP_NAME=KirimCepat
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_PORT=8000
# Wajib diisi. Generate dengan:
#   docker run --rm php:8.4-cli php -r "echo 'base64:'.base64_encode(random_bytes(32)).PHP_EOL;"
APP_KEY=
APP_TIMEZONE=Asia/Jakarta

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

LOG_CHANNEL=stderr
LOG_LEVEL=info

# --- Database (MySQL) ---
DB_DATABASE=kirimcepat
DB_USERNAME=kirimcepat
DB_PASSWORD=ganti_dengan_password_kuat
DB_ROOT_PASSWORD=ganti_dengan_root_password_kuat

# --- Opsional ---
# Migrasi otomatis saat container app start (default true)
RUN_MIGRATIONS=true
# Seeder otomatis saat start (default false; seeder bawaan membuat user dan akan error bila dijalankan dua kali)
RUN_SEEDERS=false
